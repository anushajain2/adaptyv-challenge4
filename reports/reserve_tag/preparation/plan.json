    "internal_nonbonded_distance_cutoff_A": 1.8,
    "internal_nonbonded_pairs_allowed": 0,
    "protonation": "Strip explicit H; PROPKA assigns H consistently to free and bound forms of the same prepared conformation. Any incomplete/protonation-failed group invalidates that calculation.",
    "cohort": "All confidence-selected reserve confirmation bare/tagged models, including failures and controls.",
    "movement_scope": "Target and binder-core backbone guards; full-tag movement also reported. The suffix is restrained during preparation but cannot disqualify the core solely by its flexible backbone displacement.",
    "policy": "One preparation per source; no selective retries; source sequence and original atom identities preserved; raw screen failures cannot be rescued. Original pose/contact/context gates and pKa heuristics unchanged.",
    "limitations": [
      "Fixed conformation free/bound pKa comparison",
      "No unbound ensemble or full proton linkage",
      "No assay tag modeled",
      "No experimental binding claim",
      "Finite minimization is not proof of convergence or global stereochemical validity"
    ]
  },
